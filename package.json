{
  "name": "kyminfo-filelab",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs && vite --host 0.0.0.0",
    "build": "node scripts/generate.mjs && tsc --noEmit && vite build && node scripts/check-build.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "exifreader": "^4.32.0",
    "jszip": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
